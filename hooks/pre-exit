#!/usr/bin/env bash

SYSTEM_TMPDIR="${TMPDIR:-/tmp}"
SYSTEM_TMPDIR="${SYSTEM_TMPDIR%/}"

if [[ -n "${BUILDKITE_OIDC_TMPDIR:-}" ]] && [[ "$BUILDKITE_OIDC_TMPDIR" != "/" ]] && [[ -d "$BUILDKITE_OIDC_TMPDIR" ]] && [[ "$BUILDKITE_OIDC_TMPDIR" == "$SYSTEM_TMPDIR"/* ]]; then
  rm -rf "$BUILDKITE_OIDC_TMPDIR"

  echo "Removed credentials from $BUILDKITE_OIDC_TMPDIR"
fi
